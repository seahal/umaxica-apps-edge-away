{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "umaxica-apps-edge-away",
  "main": "src/cloudflare.ts",
  // Run the Worker first so assets receive Away's security and no-store headers.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_date": "2026-05-26",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": {
    "binding": "UMAXICA-APPS-EDGE-AWAY-VERSION"
  },
  // Away-only namespace; never share Jump counters. Confirm account-wide uniqueness before rollout.
  "ratelimits": [
    {
      "name": "AWAY_RATE_LIMITER",
      "namespace_id": "521000",
      "simple": { "limit": 600, "period": 60 }
    }
  ],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "away.umaxica.net",
      "zone_name": "umaxica.net",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    // Strip query strings from platform request URLs in logs and traces.
    // Invocation logs record the request URL, so they depend on this staying
    // true. Sampling is not a privacy control and must not be used as a
    // substitute.
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true,
      "persist": true
    },
    // Query values must never be put in pathnames; platform path/metadata
    // persistence is an accepted risk.
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.02,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  }
}
