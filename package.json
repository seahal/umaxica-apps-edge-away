{
  "name": "umaxica-apps-edge-away",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "vp fmt . --write",
    "format:check": "vp fmt . --check",
    "cloudflare:check": "wrangler deploy --dry-run --outdir dist/cloudflare",
    "cloudflare:dev": "wrangler dev --local --ip 0.0.0.0 --port 5210",
    "lint": "vp lint --type-aware --fix .",
    "lint:check": "vp lint --type-aware .",
    "typecheck": "tsc --noEmit",
    "types:generate": "WRANGLER_SEND_METRICS=false wrangler types",
    "types:check": "WRANGLER_SEND_METRICS=false wrangler types --check",
    "test": "vp test run",
    "test:cov": "vp test run --coverage",
    "test:e2e": "playwright test",
    "test:worker": "node scripts/test-worker.mjs"
  },
  "dependencies": {
    "hono": "^4.13.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@hono/node-server": "^2.1.6",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "0.28.2",
    "knip": "^6.45.0",
    "miniflare": "5.20261104.0-beta",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.160.0"
  },
  "engines": {
    "node": "26.13.1",
    "pnpm": "12.21.0"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
